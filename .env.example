# Local development settings. Copy to .env (git-ignored). Nothing here is needed for a plain
# local run: `npm run job -- heartbeat --dry-run` works with no env at all.
# In the cloud, these are GitHub Actions secrets / Worker secrets, never committed values.

# --- Write-back to the Worker (only for --store remote) ---
CC_WORKER_URL=https://command-center.<your-subdomain>.workers.dev
CC_INGEST_SECRET=

# --- Notifications (only with --notify or CC_NOTIFY=ntfy) ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# NTFY_TOKEN=            # only for a reserved/protected topic

# --- Optional ---
# CC_STORE=local          # local | remote | memory
# CC_LOCAL_DB=.cc/local.db
# CC_CONFIG_PATH=config/jobs.yaml
# CC_CONFIG_YAML=         # whole config inline (used as a GitHub secret to keep searches private)
# CC_LOG_LEVEL=info       # debug | info | warn | error
# CC_LOG_STDOUT=minimal   # hide log data on stdout (full log still stored with the run)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/path/to/chrome
# GOOGLE_SERVICE_ACCOUNT_JSON=   # for the optional Sheets exporter
