{
  "name": "command-center",
  "version": "0.1.0",
  "private": true,
  "description": "Personal automation jobs: runner (GitHub Actions / local CLI), Cloudflare Worker API, PWA dashboard.",
  "type": "module",
  "bin": { "cc": "src/cli.js" },
  "scripts": {
    "cc": "node --disable-warning=ExperimentalWarning src/cli.js",
    "validate": "node --disable-warning=ExperimentalWarning src/cli.js validate",
    "job": "node --disable-warning=ExperimentalWarning src/cli.js run",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/**/*.test.js\"",
    "check": "node scripts/check-syntax.js",
    "secret-scan": "node scripts/secret-scan.js --all",
    "hooks:install": "node scripts/install-hooks.js",
    "icons": "node scripts/make-icons.js"
  },
  "engines": { "node": ">=22.13" },
  "dependencies": {
    "cheerio": "^1.2.0",
    "playwright": "^1.56.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  }
}
